Replace QA_R_1_0 101;
Replace QA_R_1_1 102;
Replace QA_R_1_2 103;
Replace QA_R_1_3 104;
Replace QA_R_1_4 105;
Replace QA_R_1_5 106;
Replace QA_R_1_6 107;
Replace QA_R_1_7 108;

I32
main
()
{
    // QA-TEST: PP-0001
    p0: I32 = QA_R_1_0;
    If ( p0 != 101 ) { Return 1; }
    // QA-TEST: PP-0002
    p1: I32 = QA_R_1_1;
    If ( p1 != 102 ) { Return 2; }
    // QA-TEST: PP-0003
    p2: I32 = QA_R_1_2;
    If ( p2 != 103 ) { Return 3; }
    // QA-TEST: PP-0004
    p3: I32 = QA_R_1_3;
    If ( p3 != 104 ) { Return 4; }
    // QA-TEST: PP-0005
    p4: I32 = QA_R_1_4;
    If ( p4 != 105 ) { Return 5; }
    // QA-TEST: PP-0006
    p5: I32 = QA_R_1_5;
    If ( p5 != 106 ) { Return 6; }
    // QA-TEST: PP-0007
    p6: I32 = QA_R_1_6;
    If ( p6 != 107 ) { Return 7; }
    // QA-TEST: PP-0008
    p7: I32 = QA_R_1_7;
    If ( p7 != 108 ) { Return 8; }
    Return 0;
}
