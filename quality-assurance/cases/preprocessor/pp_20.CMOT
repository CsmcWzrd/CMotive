Replace QA_SW_20_0 5;
Plugswitch
Plugcase DEFINED: QA_SW_20_0 >= 5
QaSwitch0: I32 = 1;
Plugdefault
QaSwitch0: I32 = 0;
Plugend

Replace QA_SW_20_1 4;
Plugswitch
Plugcase DEFINED: QA_SW_20_1 <= 5
QaSwitch1: I32 = 1;
Plugdefault
QaSwitch1: I32 = 0;
Plugend

Replace QA_SW_20_2 7;
Plugswitch
Plugcase DEFINED: QA_SW_20_2 == 7
QaSwitch2: I32 = 1;
Plugdefault
QaSwitch2: I32 = 0;
Plugend

Replace QA_SW_20_3 7;
Plugswitch
Plugcase DEFINED: QA_SW_20_3 != 8
QaSwitch3: I32 = 1;
Plugdefault
QaSwitch3: I32 = 0;
Plugend

Replace QA_SW_20_4 9;
Plugswitch
Plugcase DEFINED: QA_SW_20_4 > 2
QaSwitch4: I32 = 1;
Plugdefault
QaSwitch4: I32 = 0;
Plugend

Replace QA_SW_20_5 1;
Plugswitch
Plugcase DEFINED: QA_SW_20_5 < 3
QaSwitch5: I32 = 1;
Plugdefault
QaSwitch5: I32 = 0;
Plugend

Replace QA_SW_20_6 10;
Plugswitch
Plugcase DEFINED: QA_SW_20_6 >= 9
QaSwitch6: I32 = 1;
Plugdefault
QaSwitch6: I32 = 0;
Plugend

Replace QA_SW_20_7 2;
Plugswitch
Plugcase DEFINED: QA_SW_20_7 <= 3
QaSwitch7: I32 = 1;
Plugdefault
QaSwitch7: I32 = 0;
Plugend

I32
main
()
{
    // QA-TEST: PP-0153
    p0: I32 = QaSwitch0;
    If ( p0 != 1 ) { Return 1; }
    // QA-TEST: PP-0154
    p1: I32 = QaSwitch1;
    If ( p1 != 1 ) { Return 2; }
    // QA-TEST: PP-0155
    p2: I32 = QaSwitch2;
    If ( p2 != 1 ) { Return 3; }
    // QA-TEST: PP-0156
    p3: I32 = QaSwitch3;
    If ( p3 != 1 ) { Return 4; }
    // QA-TEST: PP-0157
    p4: I32 = QaSwitch4;
    If ( p4 != 1 ) { Return 5; }
    // QA-TEST: PP-0158
    p5: I32 = QaSwitch5;
    If ( p5 != 1 ) { Return 6; }
    // QA-TEST: PP-0159
    p6: I32 = QaSwitch6;
    If ( p6 != 1 ) { Return 7; }
    // QA-TEST: PP-0160
    p7: I32 = QaSwitch7;
    If ( p7 != 1 ) { Return 8; }
    Return 0;
}
