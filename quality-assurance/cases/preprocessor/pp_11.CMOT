#define QA_D_11_0 110
#define QA_D_11_1 111
#define QA_D_11_2 112
#define QA_D_11_3 113
#define QA_U_11_4 114
#undef QA_U_11_4
Replace QA_U_11_4 115;
#define QA_U_11_5 115
#undef QA_U_11_5
Replace QA_U_11_5 116;

Plugswitch
Plugcase DEFINED: QA_CMD_11_6 > 0
// command-line definition retained
Plugdefault
Replace QA_CMD_11_6 116;
Plugend
Plugswitch
Plugcase DEFINED: QA_CMD_11_7 > 0
// command-line definition retained
Plugdefault
Replace QA_CMD_11_7 117;
Plugend

I32
main
()
{
    // QA-TEST: PP-0081
    p0: I32 = QA_D_11_0;
    If ( p0 != 110 ) { Return 1; }
    // QA-TEST: PP-0082
    p1: I32 = QA_D_11_1;
    If ( p1 != 111 ) { Return 2; }
    // QA-TEST: PP-0083
    p2: I32 = QA_D_11_2;
    If ( p2 != 112 ) { Return 3; }
    // QA-TEST: PP-0084
    p3: I32 = QA_D_11_3;
    If ( p3 != 113 ) { Return 4; }
    // QA-TEST: PP-0085
    p4: I32 = QA_U_11_4;
    If ( p4 != 115 ) { Return 5; }
    // QA-TEST: PP-0086
    p5: I32 = QA_U_11_5;
    If ( p5 != 116 ) { Return 6; }
    // QA-TEST: PP-0087
    p6: I32 = QA_CMD_11_6;
    If ( p6 != 116 ) { Return 7; }
    // QA-TEST: PP-0088
    p7: I32 = QA_CMD_11_7;
    If ( p7 != 117 ) { Return 8; }
    Return 0;
}
