Plugin Sys::IO

Int32
main
()
{
    input : IStream;
    value : Int = 0;
    result : Int32 = input.ReadInt(&value);
    If ( result != 1 )
    {
        Return 1;
    }

    output : OStream;
    output.WriteInt(value);
    output.Write("\n");

    If ( value != 922337203685477580 )
    {
        Return 2;
    }
    Return 0;
}
