Plugin Sys::IO
Plugin Sys::String
Plugin Sys::Wide

Int32
main
()
{
    // QA-TEST: FEATURE-0081
    s : CString;
    s.Set("hello");
    If ( s.Length() != 5 )
    {
        Return 1;
    }
    If ( s.Contains("ell") == False )
    {
        Return 2;
    }
    If ( s.Compare("hello") != 0 )
    {
        Return 3;
    }
    raw : Char[160] = Contains { leading "quoted" {json} /} and /{ braces // slash };
    If ( strcmp(raw, " leading \"quoted\" {json} } and { braces / slash ") != 0 )
    {
        Return 31;
    }
    multiline : Char[64] = Contains {first
second};
    If ( strcmp(multiline, "first\nsecond") != 0 )
    {
        Return 32;
    }
    // QA-TEST: FEATURE-0082
    c : Character;
    If ( c.IsDigit('7') == False )
    {
        Return 4;
    }
    // QA-TEST: FEATURE-0083
    parser : StringParser;
    parser.Parse("a,b;c,d", ";", ",", '\\');
    If ( parser.Rows() != 2 )
    {
        Return 5;
    }
    If ( parser.Cols(0) != 2 )
    {
        Return 6;
    }
    // QA-TEST: FEATURE-0084
    w16 : Wide16String;
    If ( w16.Length() != 0 )
    {
        Return 7;
    }
    w32 : Wide32String;
    If ( w32.Length() != 0 )
    {
        Return 8;
    }
    out : OStream;
    If ( out.WriteInt(64) < 0 )
    {
        Return 9;
    }
    out.Write("\n");
    Return 0;
}
